generator client {
  provider      = "prisma-client"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String       @id @default(cuid())
  username     String       @unique
  password     String
  name         String
  sessionToken String?
  teamId       String?      @unique
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  team         Team?        @relation(fields: [teamId], references: [id])
  finalScores  FinalScore[]
}

model Team {
  id          String       @id @default(cuid())
  postId      String?
  name        String
  schoolId    String
  score       Int          @default(0)
  level       Level
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  account     Account?
  finalScores FinalScore[]
  members     Member[]
  submissions Submission[]
  post        Post?        @relation(fields: [postId], references: [id])
  school      School       @relation(fields: [schoolId], references: [id])
}

model Member {
  id        String   @id @default(cuid())
  name      String
  teamId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team?    @relation(fields: [teamId], references: [id])
}

model School {
  id        String   @id @default(cuid())
  name      String
  picName   String?
  picEmail  String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams     Team[]
}

model Post {
  id         String   @id @default(cuid())
  postNumber String
  picName    String
  level      Level
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teams      Team[]
}

model Question {
  id         String       @id @default(cuid())
  title      String
  level      Level
  difficulty Difficulty
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  roundType  RoundType    @default(PRELIMINARY)
  answers    Answer[]
  images     Image[]
  submission Submission[]
}

model Answer {
  id         String   @id @default(cuid())
  content    String?
  questionId String
  correct    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  images     Image[]
}

model Submission {
  id         String   @id @default(cuid())
  teamId     String
  questionId String
  correct    Boolean  @default(false)
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, questionId])
}

model Image {
  id         String    @id @default(cuid())
  url        String
  publicId   String    @unique
  questionId String?
  answerId   String?
  createdAt  DateTime  @default(now())
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Contest {
  id                  String         @id @default(cuid())
  name                String
  startTime           DateTime
  endTime             DateTime
  pausedTime          DateTime?
  totalPausedDuration Int            @default(0)
  frozenLeaderboard   Json?
  statusBeforePause   ContestStatus?
  status              ContestStatus  @default(PENDING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Round {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  finalScores FinalScore[]
}

model FinalScore {
  id        String   @id @default(cuid())
  judgeId   String
  teamId    String
  roundId   String
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  judge     Account  @relation(fields: [judgeId], references: [id])
  round     Round    @relation(fields: [roundId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])
}

enum Role {
  USER
  ADMIN
  MASTER
}

enum Level {
  SMP
  SMA
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RoundType {
  PRELIMINARY
  FINAL
}

enum ContestStatus {
  PENDING
  RUNNING
  FROZEN
  PAUSED
  FINISHED
}
